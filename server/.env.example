# iHub backend configuration.
#
# Copy to `.env` and fill in real values, or export these as environment variables.
# `.env` is git-ignored; never commit real credentials.
#
# Variables without a default in application.yaml are REQUIRED — the application
# refuses to start without them, by design.

# ---------------------------------------------------------------- Runtime
# `dev` enables SQL logging; `prod` keeps logs free of user data.
SPRING_PROFILES_ACTIVE=dev
PORT=8081

# ---------------------------------------------------------------- Database (required)
DB_URL=jdbc:mysql://localhost:3306/ihub?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=ihub
DB_PASSWORD=change-me
DB_POOL_MAX=10
DB_POOL_MIN=2

# ---------------------------------------------------------------- Security (required)
# Must be at least 32 characters — the app fails fast on a shorter key.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Comma-separated list of browser origins allowed to call the API directly.
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------- Search
# Search degrades gracefully when unreachable; the rest of the platform keeps working.
ES_URL=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=

# ---------------------------------------------------------------- Email
# With EMAIL_ENABLED=false, messages are logged instead of sent.
EMAIL_ENABLED=false
EMAIL_FROM=noreply@ihub.com
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------------------------------------------------------------- docker compose only
# Used by docker-compose.yml to provision the MySQL and Elasticsearch containers.
# Ignored when running the app directly against an existing database.
MYSQL_DATABASE=ihub
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PORT=3306
ELASTIC_PASSWORD=change-me
ES_PORT=9200
